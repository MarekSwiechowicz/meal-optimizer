# Klucz z console.groq.com (darmowy tier wystarcza)
GROQ_API_KEY=
# Opcjonalnie: inny model Groq, domyslnie openai/gpt-oss-120b
GROQ_MODEL=
# Profil z katalogu profiles/ (zdrowo albo wzjg albo wlasny), domyslnie zdrowo
PROFILE=zdrowo

# Maczfit (maczfit.pl, panel "Moje diety")
MACZFIT_EMAIL=
MACZFIT_PASSWORD=
# Gdy na koncie jest kilka zamowien z wyborem menu, numer tego, ktore ma byc optymalizowane
MACZFIT_ORDER_ID=

# Kuchnia Vikinga (panel.kuchniavikinga.pl)
VIKINGA_EMAIL=
VIKINGA_PASSWORD=
VIKINGA_ORDER_ID=

# Zdrowy Catering (zamowienie.zdrowycatering.pl)
ZDROWY_EMAIL=
ZDROWY_PASSWORD=

# Dowolny catering na platformie Dietly (lista company-id: node setup.js albo providers/dietly.js)
# Konto z dietly.pl loguje sie przez panel.dietly.pl; catering z wlasnym panelem wymaga DIETLY_HOST
DIETLY_COMPANY=
DIETLY_HOST=panel.dietly.pl
DIETLY_EMAIL=
DIETLY_PASSWORD=
DIETLY_ORDER_ID=
